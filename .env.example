# --- LLM provider (model-agnostic) ---
# Provider + model are config, not code. Swap either without changing source.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# --- Provider API key (set the one matching LLM_PROVIDER) ---
# Keys resolve env-var FIRST, then the macOS Keychain. Locally, prefer the
# Keychain so no key is ever written to disk:
#   security add-generic-password -a "$USER" -s GOOGLE_GENERATIVE_AI_API_KEY -w '<key>'
# In hosted environments (e.g. Vercel) there is no Keychain — set the env var there.
# Google Gemini — free tier: https://aistudio.google.com
# GOOGLE_GENERATIVE_AI_API_KEY=
# Only if you switch provider:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Local-only observability ---
# Set to any value locally to mount the /admin/traces viewer. Leave unset in production.
# ENABLE_TRACES=

# --- Optional: rate limiting (Upstash) ---
# If unset, falls back to best-effort per-instance limiting.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
